{
  "manifest_version": 3,
  "name": "Amharic Dub for YouTube",
  "version": "0.2.0",
  "description": "Dubs YouTube videos into Amharic using captions + Addis AI.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost:*/*", "http://127.0.0.1:*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["page-bridge.js"], "matches": ["https://www.youtube.com/*"] }
  ],
  "action": { "default_popup": "popup.html" }
}
